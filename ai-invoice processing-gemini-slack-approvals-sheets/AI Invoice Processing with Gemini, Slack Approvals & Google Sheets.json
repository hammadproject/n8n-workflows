    {
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  let raw = \"\";\n  const c = item.json.content;\n  if (c && typeof c === \"object\" && Array.isArray(c.parts) && c.parts[0] && typeof c.parts[0].text === \"string\") {\n    raw = c.parts[0].text;\n  } else if (typeof c === \"string\") {\n    raw = c;\n  } else if (typeof item.json.text === \"string\") {\n    raw = item.json.text;\n  } else if (typeof item.json.output === \"string\") {\n    raw = item.json.output;\n  }\n  const cleaned = raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n  let parsed = {};\n  let parseError = null;\n  if (!cleaned) {\n    parseError = \"Gemini returned no extractable text\";\n  } else {\n    try {\n      parsed = JSON.parse(cleaned);\n    } catch (e) {\n      parseError = e.message;\n    }\n  }\n  const subtotal = Number(parsed.subtotal) || 0;\n  const tax = Number(parsed.tax) || 0;\n  const total = Number(parsed.total) || 0;\n  const mathOk = Math.abs((subtotal + tax) - total) < 0.05 || total === 0;\n  const hasRequired = Boolean(parsed.vendor_name && parsed.invoice_number && total > 0);\n  const needsReview = Boolean(parseError) || !hasRequired || !mathOk;\n  results.push({\n    json: {\n      vendor_name: parsed.vendor_name || null,\n      invoice_number: parsed.invoice_number || null,\n      invoice_date: parsed.invoice_date || null,\n      due_date: parsed.due_date || null,\n      line_items: parsed.line_items || [],\n      subtotal: subtotal,\n      tax: tax,\n      total: total,\n      currency: parsed.currency || \"USD\",\n      payment_terms: parsed.payment_terms || null,\n      source: item.json.source || \"unknown\",\n      isValid: !parseError && hasRequired,\n      needsReview: needsReview,\n      parseError: parseError\n    }\n  });\n}\nreturn results;"
      },
