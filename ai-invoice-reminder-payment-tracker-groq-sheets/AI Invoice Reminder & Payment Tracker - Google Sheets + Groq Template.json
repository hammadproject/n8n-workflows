    {
      "parameters": {
        "jsCode": "const allItems = $('Format Email').all();\nconst summary = { totalReminders: allItems.length, byUrgency: {}, byType: {}, totalAmountOutstanding: 0, clients: [] };\nfor (const item of allItems) {\n  const row = item.json;\n  summary.byUrgency[row.urgencyLevel] = (summary.byUrgency[row.urgencyLevel] || 0) + 1;\n  summary.byType[row.reminderType] = (summary.byType[row.reminderType] || 0) + 1;\n  summary.totalAmountOutstanding += Number(row.invoice_amount || 0);\n  summary.clients.push({ name: row.client_name, invoice: row.invoice_number, amount: row.invoice_amount, daysOverdue: row.daysOverdue, urgency: row.urgencyLevel });\n}\nreturn [{ json: summary }];"
      },
