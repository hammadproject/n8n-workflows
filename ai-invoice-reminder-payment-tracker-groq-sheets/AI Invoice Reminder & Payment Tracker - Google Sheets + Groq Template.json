        "subject": "=Payment Confirmation - Invoice {{ $(\"Lookup Invoice\").item.json.invoice_number }}",
        "html": "=={{\n'<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#333333;line-height:1.6;\">' +\n\n  '<h2 style=\"color:#000000;margin-bottom:20px;\">Thank You!</h2>' +\n\n  '<p>Hi ' +\n    $(\"Lookup Invoice\").item.json.client_name +\n  ',</p>' +\n\n  '<p>We have successfully received your payment.</p>' +\n\n  '<div style=\"background:#f5f5f5;padding:20px;border-radius:8px;margin:20px 0;\">' +\n    '<h3 style=\"color:#000000;margin-top:0;\">Payment Details</h3>' +\n\n    '<table style=\"width:100%;border-collapse:collapse;\">' +\n      '<tr>' +\n        '<td style=\"padding:8px;font-weight:bold;\">Invoice Number:</td>' +\n        '<td style=\"padding:8px;\">' +\n          $(\"Lookup Invoice\").item.json.invoice_number +\n        '</td>' +\n      '</tr>' +\n\n      '<tr>' +\n        '<td style=\"padding:8px;font-weight:bold;\">Amount Paid:</td>' +\n        '<td style=\"padding:8px;\">' +\n          $(\"Lookup Invoice\").item.json.currency + ' ' +\n          $(\"Webhook: Payment Received\").item.json.body.amount +\n        '</td>' +\n      '</tr>' +\n\n      '<tr>' +\n        '<td style=\"padding:8px;font-weight:bold;\">Payment Method:</td>' +\n        '<td style=\"padding:8px;text-transform:capitalize;\">' +\n          $(\"Webhook: Payment Received\").item.json.body.payment_method +\n        '</td>' +\n      '</tr>' +\n\n      '<tr>' +\n        '<td style=\"padding:8px;font-weight:bold;\">Payment Status:</td>' +\n        '<td style=\"padding:8px;color:#16a34a;font-weight:bold;\">Paid</td>' +\n      '</tr>' +\n    '</table>' +\n  '</div>' +\n\n  '<p>Your invoice has been marked as paid. Please keep this email as confirmation of your payment.</p>' +\n\n  '<p style=\"margin-top:24px;\">Regards,<br><strong>Finance Team</strong></p>' +\n\n  '<div style=\"margin-top:30px;padding-top:15px;border-top:1px solid #dddddd;font-size:12px;color:#666666;\">' +\n    'This is an automated payment confirmation email.' +\n  '</div>' +\n\n'</div>'\n}}",
        "options": {
          "appendAttribution": false
        }
      },
