    {
      "parameters": {
        "fromEmail": "your-finance@example.com",
        "toEmail": "your-finance@example.com",
        "subject": "=Daily Invoice Reminder Report - {{ $now.toFormat('yyyy-MM-dd') }}",
        "html": "=={{\n'<div style=\"font-family:Arial,sans-serif;max-width:700px;margin:auto;color:#222;\">' +\n  '<h2 style=\"color:#1f2937;\">Daily Invoice Reminder Report</h2>' +\n  '<div style=\"background:#f3f4f6;padding:16px;border-radius:8px;margin-bottom:20px;\">' +\n    '<p><strong>Total reminders:</strong> ' + $json.totalReminders + '</p>' +\n    '<p><strong>Total outstanding:</strong> USD ' + $json.totalAmountOutstanding + '</p>' +\n  '</div>' +\n  '<h3>Urgency Breakdown</h3>' +\n  '<p>Medium: ' + ($json.byUrgency.medium || 0) + '</p>' +\n  '<h3>Client Details</h3>' +\n  '<table style=\"width:100%;border-collapse:collapse;\">' +\n    '<tr style=\"background:#1f2937;color:white;\">' +\n      '<th style=\"padding:10px;text-align:left;\">Client</th>' +\n      '<th style=\"padding:10px;text-align:left;\">Invoice</th>' +\n      '<th style=\"padding:10px;text-align:left;\">Amount</th>' +\n      '<th style=\"padding:10px;text-align:left;\">Overdue</th>' +\n      '<th style=\"padding:10px;text-align:left;\">Urgency</th>' +\n    '</tr>' +\n    $json.clients.map(client =>\n      '<tr style=\"border-bottom:1px solid #ddd;\">' +\n        '<td style=\"padding:10px;\">' + client.name + '</td>' +\n        '<td style=\"padding:10px;\">' + client.invoice + '</td>' +\n        '<td style=\"padding:10px;\">USD ' + client.amount + '</td>' +\n        '<td style=\"padding:10px;\">' + client.daysOverdue + ' days</td>' +\n        '<td style=\"padding:10px;text-transform:capitalize;\">' + client.urgency + '</td>' +\n      '</tr>'\n    ).join('') +\n  '</table>' +\n  '<p style=\"font-size:12px;color:#666;margin-top:24px;\">Generated automatically by the invoice reminder workflow.</p>' +\n'</div>'\n}}",
        "options": {
          "appendAttribution": false
        }
      },
