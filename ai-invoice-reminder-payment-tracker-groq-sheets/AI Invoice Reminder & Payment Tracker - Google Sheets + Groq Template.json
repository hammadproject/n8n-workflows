      "id": "b3658be3-002d-4e08-88ee-70551e4b9b54",
      "name": "Fetch Pending Invoices",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        1712,
        -128
      ],
      "notesInFlow": true,
      "typeVersion": 4.6,
      "notes": "Read invoice records from the Invoices tab"
    },
    {
      "parameters": {
        "jsCode": "const invoices = $input.all();\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\nconst results = [];\n\nfor (const invoice of invoices) {\n  const row = invoice.json;\n  if (String(row.payment_status || '').toLowerCase() === 'paid') continue;\n\n  const dueDate = new Date(row.due_date);\n  if (Number.isNaN(dueDate.getTime())) continue;\n  dueDate.setHours(0, 0, 0, 0);\n\n  const daysOverdue = Math.floor((today - dueDate) / 86400000);\n  if (daysOverdue < -7) continue;\n\n  const lastReminder = row.last_reminder_sent ? new Date(row.last_reminder_sent) : null;\n  const daysSinceReminder = lastReminder && !Number.isNaN(lastReminder.getTime())\n    ? Math.floor((today - lastReminder) / 86400000)\n    : 999;\n\n  let reminderType = '';\n  let urgencyLevel = '';\n\n  if (daysOverdue > 30 && daysSinceReminder >= 3) {\n    reminderType = 'final_notice'; urgencyLevel = 'critical';\n  } else if (daysOverdue > 14 && daysSinceReminder >= 5) {\n    reminderType = 'second_reminder'; urgencyLevel = 'high';\n  } else if (daysOverdue > 0 && daysSinceReminder >= 7) {\n    reminderType = 'first_reminder'; urgencyLevel = 'medium';\n  } else if (daysOverdue === 0 && daysSinceReminder >= 1) {\n    reminderType = 'due_today'; urgencyLevel = 'medium';\n  } else if (daysOverdue < 0 && daysOverdue >= -3 && !lastReminder) {\n    reminderType = 'upcoming_reminder'; urgencyLevel = 'low';\n  } else {\n    continue;\n  }\n\n  results.push({ json: { ...row, daysOverdue, daysSinceReminder, reminderType, urgencyLevel } });\n}\n\nreturn results;"
      },
      "id": "9ee5c3ce-50ec-4793-a1b0-4e014f0984ca",
      "name": "Calculate Reminder Logic",
      "type": "n8n-nodes-base.code",
      "position": [
        2160,
        -128
      ],
      "notesInFlow": true,
      "typeVersion": 2,
      "notes": "Smart logic for reminder timing"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ai-prompt",
              "name": "aiPrompt",
              "type": "string",
              "value": "=Write a professional payment reminder email using the following information:\n\nClient Name: {{ $json.client_name }}\nInvoice Number: {{ $json.invoice_number }}\nAmount: {{ $json.currency }} {{ $json.invoice_amount }}\nIssue Date: {{ $json.issue_date }}\nDue Date: {{ $json.due_date }}\nDays Overdue: {{ $json.daysOverdue }}\nReminder Type: {{ $json.reminderType }}\nUrgency Level: {{ $json.urgencyLevel }}\n\nRequirements:\n- Address the client by name.\n- Clearly mention the invoice number, amount, and due date.\n- Explain whether the invoice is due soon, due today, or overdue.\n- Politely ask the customer to complete the outstanding payment.\n- If appropriate, tell them to disregard the reminder if payment has already been made.\n- Do not include or mention any payment link or payment button.\n- Do not include placeholders.\n- Do not invent company information.\n- End exactly with:\n\nBest regards,\nFinance Team"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "40138aff-7c56-4670-98a1-df4376e538e9",
      "name": "Prepare AI Prompt",
      "type": "n8n-nodes-base.set",
      "position": [
        2384,
        -128
      ],
      "typeVersion": 3.4
    },
    {
      "parameters": {
        "jsCode": "const aiItems = $input.all();\nconst originals = $('Calculate Reminder Logic').all();\n\nreturn aiItems.map((item, index) => {\n  const original = originals[index]?.json || {};\n\n  const aiResponse =\n    item.json.output ||\n    item.json.text ||\n    item.json.response ||\n    item.json.message?.content ||\n    '';\n\n  const subjectMatch = aiResponse.match(\n    /Subject:\\s*(.+?)(?:\\r?\\n|$)/i\n  );\n\n  const subject = subjectMatch\n    ? subjectMatch[1].trim()\n    : `Payment Reminder - Invoice ${original.invoice_number}`;\n\n  let body = aiResponse\n    .replace(/Subject:\\s*(.+?)(?:\\r?\\n|$)/i, '')\n    .trim();\n\n  // Remove AI-generated placeholders and payment-link instructions.\n  // The payment button is added separately below.\n  body = body\n    .replace(/\\[Your Name\\]/gi, 'Finance Team')\n    .replace(/\\[Company Name\\]/gi, '')\n    .replace(/\\[Your Company Name\\]/gi, '')\n    .replace(/\\[Your Company\\]/gi, '')\n    .replace(/^.*\\[Payment Link\\].*$/gim, '')\n    .replace(/^.*the Pay Invoice button below.*$/gim, '')\n    .replace(/^.*via the link below.*$/gim, '')\n    .replace(/^.*use the payment link below.*$/gim, '')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n\n  // Escape AI text before inserting it into the HTML email.\n  body = body\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\\n/g, '<br>');\n\n  const status =\n    original.daysOverdue > 0\n      ? `Overdue by ${original.daysOverdue} days`\n      : original.daysOverdue === 0\n        ? 'Due today'\n        : 'Due soon';\n\n  const statusColor =\n    original.daysOverdue > 0 ? '#d32f2f' : '#f57c00';\n\n  const paymentUrl =\n    `https://your-payment-page.example.com/` +\n    `?invoice=${encodeURIComponent(original.invoice_number)}` +\n    `&amount=${encodeURIComponent(original.invoice_amount)}` +\n    `&currency=${encodeURIComponent(original.currency)}` +\n    `&name=${encodeURIComponent(original.client_name)}`;\n\n  const invoiceTable = `\n    <div style=\"\n      background:#f5f5f5;\n      padding:20px;\n      border-radius:8px;\n      margin:20px 0;\n    \">\n      <h3 style=\"\n        margin-top:0;\n        margin-bottom:12px;\n        color:#000000;\n      \">\n        Invoice Details\n      </h3>\n\n      <table style=\"\n        width:100%;\n        border-collapse:collapse;\n      \">\n        <tr>\n          <td style=\"\n            padding:8px;\n            font-weight:bold;\n          \">\n            Invoice Number:\n          </td>\n\n          <td style=\"padding:8px;\">\n            ${original.invoice_number}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"\n            padding:8px;\n            font-weight:bold;\n          \">\n            Amount:\n          </td>\n\n          <td style=\"padding:8px;\">\n            ${original.currency} ${original.invoice_amount}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"\n            padding:8px;\n            font-weight:bold;\n          \">\n            Due Date:\n          </td>\n\n          <td style=\"padding:8px;\">\n            ${original.due_date}\n          </td>\n        </tr>\n\n        <tr>\n          <td style=\"\n            padding:8px;\n            font-weight:bold;\n          \">\n            Status:\n          </td>\n\n          <td style=\"\n            padding:8px;\n            color:${statusColor};\n            font-weight:bold;\n          \">\n            ${status}\n          </td>\n        </tr>\n      </table>\n    </div>\n  `;\n\n  const paymentButton = `\n    <div style=\"\n      margin:24px 0;\n      text-align:left;\n    \">\n      <p style=\"\n        margin:0 0 12px 0;\n        color:#333333;\n      \">\n        To complete your payment, please use the button below:\n      </p>\n\n      <a\n        href=\"${paymentUrl}\"\n        target=\"_blank\"\n        style=\"\n          display:inline-block;\n          padding:12px 22px;\n          background-color:#2563eb;\n          color:#ffffff;\n          text-decoration:none;\n          border-radius:6px;\n          font-weight:bold;\n        \"\n      >\n        Pay Invoice\n      </a>\n    </div>\n  `;\n\n  const firstBreak = body.indexOf('<br>');\n\n  const greeting =\n    firstBreak >= 0\n      ? body.slice(0, firstBreak)\n      : body;\n\n  const remainder =\n    firstBreak >= 0\n      ? body.slice(firstBreak + 4)\n      : '';\n\n  const emailBody = `\n    <html>\n      <body style=\"\n        font-family:Arial,sans-serif;\n        line-height:1.6;\n        color:#333333;\n        max-width:650px;\n        margin:0 auto;\n      \">\n        ${greeting}\n\n        ${invoiceTable}\n\n        ${paymentButton}\n\n        ${remainder}\n\n        <div style=\"\n          margin-top:30px;\n          padding-top:20px;\n          border-top:1px solid #dddddd;\n          font-size:12px;\n          color:#666666;\n        \">\n          This is an automated reminder. If payment has already\n          been made, please disregard this email.\n        </div>\n      </body>\n    </html>\n  `;\n\n  return {\n    json: {\n      ...original,\n      aiResponse,\n      paymentUrl,\n      emailSubject: subject,\n      emailBody\n    }\n  };\n});"
      },
