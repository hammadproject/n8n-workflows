      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "## Important: namespace reset\n\nBefore every ingestion run, these nodes resolve the Pinecone index host and delete every existing vector from `YOUR_PINECONE_NAMESPACE`. The workflow then rebuilds the namespace from the current website content, preventing duplicate chunks across repeated runs.\n\nThis deletion is destructive. Use a dedicated namespace, replace `YOUR_PINECONE_INDEX` and `YOUR_PINECONE_NAMESPACE`, and never point this step at vectors you need to preserve.",
        "height": 288,
        "width": 460,
        "color": 3
      },
      "id": "445bbb5e-440a-4725-bc10-d2b33ddc8480",
      "name": "Sticky Note - Namespace Reset",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -2640,
        848
      ],
      "typeVersion": 1
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
