    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const html = $json.html;\n\nconst text = html\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  // Safety net: strip any lone/broken surrogate pairs (invalid unicode)\n  // that may already exist in the source HTML, e.g. from bad encoding.\n  .replace(/[\\uD800-\\uDFFF]/g, '')\n  .trim();\n\nreturn {\n  url: $json.url,\n  project_id: $json.project_id,\n  text\n};\n"
      },
      "id": "c191253f-f453-4d2f-9127-cbf65911b21b",
      "name": "Clean HTML to Text",
      "type": "n8n-nodes-base.code",
      "position": [
        80,
        192
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "aa3e5022-2d6d-43f6-bf87-9de112a3345f",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              },
              "leftValue": "={{ $json.text > 50}}",
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "97805b2e-7ab8-46f8-b189-d1cd7f78572e",
      "name": "Check Text Length",
      "type": "n8n-nodes-base.if",
      "position": [
        304,
        192
      ],
      "typeVersion": 2.3
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.text || \"\";\nconst text = raw.replace(/\\s+/g, \" \").trim();\nconst chunkSize = 1000;\nconst overlap = 200;\n\n// Split by Unicode code points (not raw UTF-16 units) so we never cut\n// an emoji / special character in half and create invalid unicode.\nconst codePoints = Array.from(text);\n\nconst chunks = [];\nlet i = 0;\n\nwhile (i < codePoints.length) {\n  const chunk = codePoints.slice(i, i + chunkSize).join(\"\").trim();\n\n  if (chunk.length > 50) {\n    chunks.push({\n      content: chunk,\n      url: $json.url,\n      project_id: $json.project_id\n    });\n  }\n\n  i += chunkSize - overlap;\n}\n\nreturn chunks;\n"
      },
      "id": "afb91e79-599f-4fc6-bb19-b7f0c0e4fcb4",
      "name": "Split Text into Chunks",
      "type": "n8n-nodes-base.code",
      "position": [
        528,
        176
      ],
      "typeVersion": 2
