      ],
      "typeVersion": 1.1,
      "webhookId": "3ef26bea-cc37-420a-b5f0-ed7eb1545f77"
    },
    {
      "parameters": {
        "contextWindowLength": 10
      },
      "id": "f2f965de-b428-4ac4-933f-e4852393c292",
      "name": "Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "position": [
        -1248,
        1040
      ],
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "=You are **Alicia**, an AI customer support assistant for our company.\n\nToday's date is {{ $now.format('yyyy-MM-dd') }}. Use this date as the only reference for relative time.\n\nPRIMARY RULE\nAll business info (products, services, company info, website content, policies/FAQs, pricing, contact details) MUST come from tools — never from memory or assumptions.\n\nPINECONE USAGE\nUse the vector store tool for: products/services, offerings, policies, pricing, FAQs, company/site info.\nDo NOT use it for: greetings, small talk, personal details, scheduling.\nIf it returns nothing useful, reply exactly: \"I could not find that information. Would you like me to create a support ticket for you?\"\n\nMEMORY USAGE\nOnly store name/email/phone, and only after a confirmed booking. Never store product/company info in memory.\n\nGREETING RULE\nIf the user only says hi/hello/hey, reply exactly: \"Hi, how can I help you today?\" — no tools, no extra text.\n\nRESPONSE RULES\nBe friendly, concise, conversational. Never mention internal tools or reasoning. Never say \"as an AI\".\n\nLINK RULE\nLinks only from tool output, formatted as [text](url) — never raw URLs.\n\nFAILURE RULE\nAny tool failure → reply exactly: \"I could not find that information. Would you like me to create a support ticket for you?\"",
          "maxIterations": 10,
          "returnIntermediateSteps": false
        }
      },
      "id": "4340a55e-d51b-46c9-9ec6-b2bc0ce315b7",
      "name": "Customer Support Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -1344,
        816
      ],
      "typeVersion": 3
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "=Use this tool whenever the user asks anything about our services, company info, website content, product/service details, policies, FAQs, contact information, pricing, or anything requiring knowledge from the company knowledge base.",
        "pineconeIndex": {
          "__rl": true,
          "value": "YOUR_PINECONE_INDEX",
          "mode": "id"
        },
        "topK": 10,
        "options": {
          "pineconeNamespace": "YOUR_PINECONE_NAMESPACE"
        }
      },
      "id": "73e4a368-2789-4a1a-a24a-327184798c91",
      "name": "Pinecone Vector Storage",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "position": [
