        }
      }
    },
    {
      "parameters": {
        "jsCode": "// input: { success: true, links: [ { url: \"...\" } ] }\n\nconst links = $json.links || [];\nconst seen = new Set();\n\nconst blockedKeywords = [\n  \"/press-blog\",\n  \"/newsletter\",\n  \"/assets-vault\",\n  \"press\",\n  \"gallery\",\n  \"project\",\n  \"newsletter\"\n];\n\nreturn links\n  .filter(link => {\n    let url = link.url;\n    if (!url) return false;\n\n    for (const keyword of blockedKeywords) {\n      if (url.includes(keyword)) return false;\n    }\n\n    if (url.includes(\".xml\")) return false;\n\n    url = url.endsWith(\"/\") ? url.slice(0, -1) : url;\n\n    if (seen.has(url)) return false;\n    seen.add(url);\n\n    link.url = url;\n    return true;\n  })\n  .map(link => ({ url: link.url }));\n"
      },
      "id": "0bacbdb3-5c4d-4e15-ba44-ee90af9f2871",
      "name": "Filter and Normalize URLs",
      "type": "n8n-nodes-base.code",
      "position": [
        -1040,
        272
      ],
      "typeVersion": 2
    },
