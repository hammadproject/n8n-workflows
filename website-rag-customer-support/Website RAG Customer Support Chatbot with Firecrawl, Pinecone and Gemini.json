      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -1904,
        464
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://' + $json.host + '/vectors/delete' }}",
